---
import { nav } from '../data/site';
---

<header class="site-header nav">
  <div class="bar">
    <a href="/" class="logo" aria-label="S-Maal — strona główna">S<span>-</span>MAAL</a>
    <nav aria-label="Główna nawigacja">
      <ul>
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>
    <a href="/#kontakt" class="btn cta">Umów konsultację</a>
    <button class="burger" type="button" aria-label="Menu" aria-expanded="false"><span></span><span></span></button>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header')!;
  const burger = header.querySelector<HTMLButtonElement>('.burger')!;
  const nav = header.querySelector('nav')!;
  // otwarte menu blokuje przewijanie (Lenis + natywny touch) i fokus na stronie pod spodem
  const isOpen = () => document.documentElement.classList.contains('nav-open');
  const setOpen = (open: boolean) => {
    document.documentElement.classList.toggle('nav-open', open);
    burger.setAttribute('aria-expanded', String(open));
    (window as any).lenis?.[open ? 'stop' : 'start']();
    document.querySelectorAll<HTMLElement>('main, footer').forEach((el) => (el.inert = open));
    if (open) nav.querySelector('a')!.focus();
  };
  burger.addEventListener('click', () => setOpen(!isOpen()));
  nav.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen()) {
      setOpen(false);
      burger.focus();
    }
  });
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    color: var(--stone);
    transition: background 0.4s;
  }
  /* ten sam wygląd przy każdym położeniu scrolla. Blur na pseudo-elemencie: backdrop-filter na samym
     nagłówku robił z niego containing block dla fixed nav i panel menu kurczył się do wysokości paska */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(22, 21, 19, 0.92);
    backdrop-filter: blur(14px);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 32px;
    width: min(100% - 2 * var(--gutter), var(--max));
    margin-inline: auto;
    height: 76px;
  }
  .logo {
    font: 500 1.45rem/1 var(--serif);
    letter-spacing: 0.08em;
    text-decoration: none;
    margin-right: auto;
  }
  .logo span {
    color: var(--brass);
  }
  ul {
    display: flex;
    gap: 30px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    text-decoration: none;
    font-size: 0.92rem;
    opacity: 0.82;
    transition: opacity 0.3s;
  }
  nav a:hover {
    opacity: 1;
  }
  .cta {
    padding: 12px 20px;
    font-size: 0.88rem;
  }
  .burger {
    display: none;
    width: 44px;
    height: 44px;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    position: relative;
  }
  .burger span {
    position: absolute;
    left: 10px;
    right: 10px;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.4s var(--ease);
  }
  .burger span:first-child {
    top: 17px;
  }
  .burger span:last-child {
    top: 26px;
  }

  @media (max-width: 960px) {
    .cta {
      display: none;
    }
    .burger {
      display: block;
    }
    nav {
      position: fixed;
      inset: 76px 0 0;
      background: var(--ink);
      padding: 40px var(--gutter);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      /* visibility przełącza się po zgaszeniu, ale przy otwarciu od razu — inaczej focus() na linku nie działa */
      transition:
        opacity 0.4s,
        visibility 0s 0.4s;
    }
    ul {
      flex-direction: column;
      gap: 22px;
    }
    nav a {
      font: 400 2rem/1.1 var(--serif);
      opacity: 1;
    }
    :global(html.nav-open) {
      overflow: hidden;
    }
    :global(.nav-open) nav {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transition: opacity 0.4s;
    }
    :global(.nav-open) .site-header {
      background: var(--ink);
    }
    :global(.nav-open) .burger span:first-child {
      transform: translateY(4.5px) rotate(45deg);
    }
    :global(.nav-open) .burger span:last-child {
      transform: translateY(-4.5px) rotate(-45deg);
    }
  }
</style>
