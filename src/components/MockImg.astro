---
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  widths?: number[];
  class?: string;
  loading?: 'lazy' | 'eager';
  before?: boolean; // filtr "surowy beton" dla suwaka przed/po
}

const { src, alt, sizes = '100vw', widths = [480, 800, 1200, 1600], class: cls, loading = 'lazy', before } = Astro.props;
---

<figure class:list={['mock', cls, { before }]}>
  <Picture src={src} alt={alt} sizes={sizes} widths={widths} formats={['avif', 'webp']} loading={loading} />
</figure>

<style>
  .mock {
    position: relative;
    margin: 0;
    overflow: hidden;
  }
  .mock :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .before :global(img) {
    filter: grayscale(1) contrast(0.82) brightness(0.92) sepia(0.12);
  }
  .before::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 30% 20%, rgba(255, 255, 255, 0.08), transparent 60%),
      repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.035) 0 2px, transparent 2px 5px),
      rgba(120, 115, 108, 0.32);
    mix-blend-mode: multiply;
  }
</style>
