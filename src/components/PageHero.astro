---
import MockImg from './MockImg.astro';

interface Props {
  crumbs: { name: string; path: string }[];
  eyebrow: string;
  title: string;
  lead?: string;
  image?: ImageMetadata;
  alt?: string;
}
const { crumbs, eyebrow, title, lead, image, alt = '' } = Astro.props;
---

<section class="page-hero dark">
  <div class="wrap inner">
    <nav aria-label="Okruszki" class="crumbs">
      <a href="/">S-Maal</a>
      {
        crumbs.map((c, i) =>
          i === crumbs.length - 1 ? (
            <span aria-current="page">{c.name}</span>
          ) : (
            <a href={c.path}>{c.name}</a>
          ),
        )
      }
    </nav>
    <span class="eyebrow">{eyebrow}</span>
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
  {image && <MockImg src={image} alt={alt} loading="eager" class="cover" sizes="(orientation: portrait) 110vh, 100vw" />}
</section>

<style>
  .page-hero {
    padding-top: 150px;
  }
  .inner {
    display: grid;
    gap: 22px;
    justify-items: start;
    padding-bottom: clamp(50px, 7vw, 90px);
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 0.82rem;
    color: var(--muted-dark);
  }
  .crumbs > * + *::before {
    content: '/';
    margin-right: 10px;
    opacity: 0.5;
  }
  .crumbs a {
    text-decoration: none;
  }
  h1 {
    font-size: clamp(2.6rem, 6vw, 5.4rem);
    max-width: 14em;
  }
  .lead {
    max-width: 640px;
    font-size: 1.1rem;
    color: #d6cfc3;
  }
  .page-hero :global(.cover) {
    height: min(72vh, 760px);
  }
</style>
