---
import { faq } from '../../data/faq';
---

<section id="faq" class="section faq" style="--hm: 2">
  <div class="wrap grid">
    <div class="section-head">
      <h2>Najczęstsze <em>pytania</em></h2>
      <p class="muted">Nie ma tu Twojego? Zapytaj na konsultacji. Odpowiadamy konkretnie, z liczbami.</p>
    </div>
    <div class="list">
      {
        faq.map((f, i) => (
          <details name="faq" open={i === 0}>
            <summary>
              <h3>{f.q}</h3>
              <span class="plus" aria-hidden="true" />
            </summary>
            <p class="muted">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    background: var(--stone);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    align-items: start;
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 14px 0;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .plus {
    position: relative;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--line);
    transition: background 0.3s;
  }
  .plus::before,
  .plus::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 1.5px;
    background: currentColor;
    translate: -50% -50%;
  }
  .plus::after {
    rotate: 90deg;
  }
  /* otwarte: plus zamienia się w minus, bez obracania */
  details[open] .plus {
    background: var(--brass);
    border-color: var(--brass);
  }
  details[open] .plus::after {
    opacity: 0;
  }
  details p {
    padding: 0 60px 28px 0;
    max-width: 680px;
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .section-head {
      margin-bottom: 0;
    }
    details p {
      padding-right: 0;
    }
  }
</style>
