---
import HeroScene from '../../three/HeroScene';
import MockImg from '../MockImg.astro';
import fallback from '../../assets/img/salon-3.jpg';
import { heroStages } from '../../lib/stages';
---

<section id="hero" class="hero dark" aria-labelledby="hero-title">
  <div class="sticky">
    <MockImg src={fallback} alt="Wykończony salon z jadalnią — przykład" class="fallback" sizes="(orientation: portrait) 150vh, 100vw" />
    <HeroScene client:only="react" />
    <div class="shade" aria-hidden="true"></div>

    <div class="wrap copy">
      <span class="eyebrow"><span class="eb"><span>Dokładnie co do milimetra</span><span class="sep"> · </span><span>czysto każdego dnia</span></span></span>
      <h1 id="hero-title">Wykończenia wnętrz <em>pod&nbsp;klucz</em> na&nbsp;Śląsku</h1>
      <p class="lead">
        <span class="intro">Wykańczamy mieszkania i domy pod klucz. </span>Ściany odbieramy łatą 2&nbsp;m z odchyłką do 2&nbsp;mm, a po każdym dniu pracy sprzątamy. Po odbiorze zostaje Ci tylko wnieść meble.
      </p>
      <div class="actions">
        <a href="#kontakt" class="btn">Umów bezpłatną konsultację</a>
        <a href="#kalkulator" class="btn ghost">Policz koszt</a>
      </div>
    </div>

    <ol class="wrap stages" aria-label="Etapy wykończenia">
      {
        heroStages.map((s, i) => (
          <li class:list={['stage', { active: i === 0 }]}>
            <span class="n">
              {s.n} <span class="of">/ 0{heroStages.length}</span>
            </span>
            <p class="t">{s.title}</p>
            <p class="d">{s.text}</p>
          </li>
        ))
      }
      <li class="bar" aria-hidden="true"><span></span></li>
    </ol>

    <p class="hint" aria-hidden="true">Przewiń, aby wykończyć mieszkanie</p>
  </div>
</section>

<script>
  import { heroStages, sectionProgress, seg } from '../../lib/stages';

  const hero = document.getElementById('hero')!;
  if (!document.documentElement.classList.contains('no-3d')) {
    const stages = [...hero.querySelectorAll<HTMLElement>('.stage')];
    const bar = hero.querySelector<HTMLElement>('.bar span')!;
    const fade = hero.querySelectorAll<HTMLElement>('.copy, .hint');
    const actions = hero.querySelector<HTMLElement>('.actions')!;
    let last = 0;
    const update = () => {
      const p = sectionProgress(hero);
      let idx = 0;
      heroStages.forEach((s, i) => p >= s.at && (idx = i));
      if (idx !== last) {
        stages.forEach((el, i) => el.classList.toggle('active', i === idx));
        last = idx;
      }
      bar.style.transform = `scaleX(${p})`;
      const f = seg(p, 0.015, 0.09);
      hero.style.setProperty('--f', String(f));
      fade.forEach((el) => {
        el.style.opacity = String(1 - f);
        el.style.transform = `translateY(${-f * 50}px)`;
        el.style.pointerEvents = f >= 1 ? 'none' : '';
      });
      // h1 zostaje w drzewie dostępności; niewidoczne przyciski nie łapią fokusu
      actions.inert = f >= 1;
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>

<style>
  /* pełne ekrany: kolejne sekcje zaczynają się na granicy ekranu */
  .hero {
    height: 400vh;
    position: relative;
  }
  .sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
  }
  .sticky :global(.hero-canvas),
  .sticky :global(.fallback) {
    position: absolute;
    inset: 0;
  }
  .sticky :global(.fallback) {
    display: none;
  }
  .shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(90deg, rgba(22, 21, 19, 0.85) 0%, rgba(22, 21, 19, 0.35) 38%, transparent 60%);
  }
  .copy {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    translate: 0 -55%;
    display: grid;
    gap: 26px;
    justify-items: start;
    isolation: isolate;
  }
  /* pionowy ekran: makieta wypada pod tekstem — przyciemnienie pod tekstem, znika razem z nim */
  @media (orientation: portrait) {
    .copy::before {
      content: '';
      position: absolute;
      inset: -96px calc(-1 * var(--gutter)) -48px;
      z-index: -1;
      background: linear-gradient(180deg, transparent, rgba(22, 21, 19, 0.72) 96px, rgba(22, 21, 19, 0.62) 80%, transparent);
      pointer-events: none;
    }
  }
  /* 72px przy 1440: nagłówek kończy się przed ścianą makiety */
  .copy h1 {
    font-size: clamp(2.8rem, 5vw, 4.5rem);
    max-width: 9.5em;
  }
  .lead {
    max-width: 30em;
    font-size: 1.1rem;
    color: #d6cfc3;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .stages {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(28px, 6vh, 64px);
    list-style: none;
    padding: 0;
    height: 150px;
  }
  .stage {
    position: absolute;
    left: 0;
    bottom: 14px;
    max-width: 380px;
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.5s var(--ease),
      transform 0.6s var(--ease);
  }
  .stage.active {
    opacity: 1;
    transform: none;
  }
  .n {
    font: 600 0.75rem/1 var(--sans);
    letter-spacing: 0.18em;
    color: var(--brass);
  }
  .of {
    color: var(--muted-dark);
  }
  .t {
    font: 380 1.7rem/1.1 var(--serif);
    margin: 10px 0 6px;
  }
  .d {
    font-size: 0.95rem;
    color: var(--muted-dark);
  }
  .bar {
    position: absolute;
    left: 0;
    bottom: 0;
    width: min(380px, 100%);
    height: 1px;
    background: var(--line-dark);
  }
  .bar span {
    position: absolute;
    inset: 0;
    background: var(--brass);
    transform-origin: left;
    transform: scaleX(0);
  }
  .hint {
    position: absolute;
    left: 50%;
    bottom: 28px;
    translate: -50% 0;
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted-dark);
    padding-bottom: 46px;
  }
  .hint::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 1px;
    height: 36px;
    background: linear-gradient(var(--brass), transparent);
    animation: drip 2s var(--ease) infinite;
  }
  @keyframes drip {
    0% {
      transform: scaleY(0);
      transform-origin: top;
    }
    50% {
      transform: scaleY(1);
      transform-origin: top;
    }
    51% {
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }

  /* bez 3D: zwykły hero ze zdjęciem i wszystkimi etapami */
  :global(.no-3d) .hero {
    height: auto;
  }
  :global(.no-3d) .sticky {
    position: relative;
    height: auto;
    min-height: 100svh;
    padding: 140px 0 60px;
  }
  /* zdjęcie tylko na pierwszy ekran — rozciągnięte na całą wysokość bloku było rozmyte */
  :global(.no-3d) .sticky :global(.fallback) {
    display: block;
    bottom: auto;
    height: 100svh;
    mask-image: linear-gradient(#000 70%, transparent);
  }
  :global(.no-3d) .shade {
    background: linear-gradient(90deg, rgba(22, 21, 19, 0.9), rgba(22, 21, 19, 0.55));
  }
  :global(.no-3d) .copy,
  :global(.no-3d) .stages {
    position: relative;
    translate: none;
    top: auto;
    bottom: auto;
    height: auto;
  }
  :global(.no-3d) .stages {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 28px;
    margin-top: 60px;
  }
  :global(.no-3d) .stage {
    position: static;
    opacity: 1;
    transform: none;
  }
  :global(.no-3d) .bar,
  :global(.no-3d) .hint {
    display: none;
  }

  /* niski ekran: aktywny etap nachodził na przyciski — etapy wchodzą, gdy tekst hero znika */
  @media (max-height: 820px) {
    .stages {
      opacity: var(--f, 1);
    }
  }
  @media (max-width: 1100px) {
    .hint {
      left: auto;
      right: var(--gutter);
      translate: none;
    }
  }

  /* telefon: tekst przy dolnej krawędzi, makieta ma wolną górę ekranu; mniej treści niż na desktopie */
  @media (max-width: 760px) {
    .shade {
      background: linear-gradient(180deg, rgba(22, 21, 19, 0.6) 0%, transparent 16%, transparent 38%, rgba(22, 21, 19, 0.88) 68%);
    }
    .copy {
      top: auto;
      bottom: 20px;
      translate: none;
      gap: 14px;
    }
    /* eyebrow w dwóch równych liniach zamiast zawiniętego w pół zdania */
    .eb {
      display: grid;
      gap: 2px;
    }
    .copy .eyebrow::before,
    .sep,
    .intro {
      display: none;
    }
    .copy h1 {
      font-size: clamp(1.9rem, 8.6vw, 2.6rem);
    }
    .lead {
      font-size: 0.95rem;
      line-height: 1.55;
    }
    /* jeden pełny przycisk + „Policz koszt” jako link pod nim */
    .actions {
      display: grid;
      justify-self: stretch;
      gap: 2px;
      margin-top: 4px;
    }
    .actions :global(.ghost),
    .actions :global(.ghost:hover) {
      background: none;
      border-color: transparent;
      backdrop-filter: none;
      padding-block: 12px;
    }
    .actions :global(.ghost)::after {
      content: '→';
    }
    .stages {
      bottom: 64px;
      height: 130px;
      opacity: var(--f, 1);
    }
    .t {
      font-size: 1.4rem;
    }
    .hint {
      display: none;
    }
  }
  /* niskie telefony (SE, małe Androidy) */
  @media (max-width: 760px) and (max-height: 600px) {
    .copy {
      gap: 10px;
    }
    .copy h1 {
      font-size: clamp(1.7rem, 8.4vw, 2.2rem);
    }
    .lead {
      font-size: 0.9rem;
      line-height: 1.5;
    }
    .actions :global(.btn:not(.ghost)) {
      padding-block: 13px;
    }
  }
</style>
