---
// Opinie przykładowe — do podmiany na prawdziwe (np. z wizytówki Google).
const reviews = [
  {
    text: 'Na odbiór przyszliśmy z własną poziomicą i nie znaleźliśmy niczego do poprawy. Fugi w łazience idą w jednej linii przez całą ścianę, a w protokole były pomiary każdej ściany.',
    who: 'Anna i Michał',
    where: 'Katowice, 92 m²',
  },
  {
    text: 'Remont z wyburzaniem ścian w bloku, a na klatce ani jednego worka gruzu. Po każdym dniu pracy mieszkanie było odkurzone, a sąsiedzi nie mieli żadnych uwag.',
    who: 'Tomasz',
    where: 'Gliwice, 64 m²',
  },
  {
    text: 'Dom pod klucz w niecałe pół roku, a na koniec dostaliśmy go umytego: okna, fugi, podłogi. Meble wnieśliśmy tego samego dnia.',
    who: 'Katarzyna',
    where: 'Mikołów, 186 m²',
  },
];
---

<section class="section opinie" style="--hm: 2">
  <div class="wrap">
    <div class="section-head">
      <h2>Opinie <em>klientów</em></h2>
    </div>
    <div class="grid">
      {
        reviews.map((r, i) => (
          <figure class="review">
            <div class="stars" role="img" aria-label="Ocena 5 na 5">
              ★★★★★
            </div>
            <blockquote>„{r.text}”</blockquote>
            <figcaption>
              <strong>{r.who}</strong>
              <span class="muted">{r.where}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .opinie {
    background: var(--stone-2);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .review {
    position: relative;
    margin: 0;
    padding: 36px 32px;
    display: grid;
    gap: 18px;
    align-content: start;
    background: var(--stone);
    border-radius: 20px;
  }
  .stars {
    color: var(--accent);
    letter-spacing: 0.2em;
  }
  blockquote {
    margin: 0;
    font: 380 1.4rem/1.45 var(--serif);
  }
  figcaption {
    display: grid;
    gap: 2px;
    font-size: 0.9rem;
  }
  strong {
    font-weight: 600;
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
