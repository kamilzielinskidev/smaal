---
import { getCollection } from 'astro:content';
import BeforeAfter from '../BeforeAfter.astro';
import { cities } from '../../data/site';

const items = (await getCollection('realizacje')).sort((a, b) => a.data.order - b.data.order);
const cityName = (slug: string) => cities.find((c) => c.slug === slug)?.name ?? slug;
---

<section id="realizacje" class="realizacje g2" style="--h: 2">
  <div class="wrap">
    {
      [items.slice(0, 2), items.slice(2)].map((row, i) => (
        <div class="group">
          {i === 0 && (
            <div class="head">
              <h2>
                Realizacje <em>przed</em> i po
              </h2>
              <p class="muted">Każde wnętrze zaczynało się od surowego betonu. Przeciągnij suwak na zdjęciu, a potem zajrzyj do opisu realizacji.</p>
            </div>
          )}
          <div class="cards">
            {row.map((r) => (
              <article class="card">
                <BeforeAfter src={r.data.cover} alt={r.data.title} sizes="(min-width: 640px) 46vw, 92vw" />
                <div class="meta">
                  <div>
                    <h3>
                      <a href={`/realizacje/${r.id}`}>{r.data.title}</a>
                    </h3>
                    <p class="muted">
                      {cityName(r.data.city)}, {r.data.district} · {r.data.area} m² · {r.data.standard}
                    </p>
                  </div>
                  <a href={`/realizacje/${r.id}`} class="more" aria-label={`Zobacz realizację: ${r.data.title}`}>
                    Zobacz →
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .realizacje {
    background: var(--stone);
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 20px 40px;
    flex-wrap: wrap;
    margin-bottom: 48px;
  }
  .head p {
    max-width: 420px;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }
  .meta {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
    padding-top: 18px;
  }
  .meta h3 a {
    text-decoration: none;
  }
  .meta p {
    font-size: 0.9rem;
    margin-top: 6px;
  }
  /* cel dotyku 44px */
  .more {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    white-space: nowrap;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--accent);
  }
  @media (max-width: 639px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
