---
import { getCollection } from 'astro:content';
import BeforeAfter from '../BeforeAfter.astro';
import { cities } from '../../data/site';

const items = (await getCollection('realizacje')).sort((a, b) => a.data.order - b.data.order);
const cityName = (slug: string) => cities.find((c) => c.slug === slug)?.name ?? slug;
---

<section id="realizacje" class="realizacje">
  <div class="pin">
    <div class="wrap head">
      <div>
        <span class="eyebrow">Realizacje</span>
        <h2>Przesuń, by zobaczyć <em>różnicę</em></h2>
      </div>
      <p class="muted">Każde wnętrze zaczynało się od surowego betonu. Przeciągnij suwak na zdjęciu, a potem zajrzyj do opisu realizacji.</p>
    </div>
    <div class="track">
      {
        items.map((r) => (
          <article class="card">
            <BeforeAfter src={r.data.cover} alt={r.data.title} sizes="(min-width: 900px) 56vw, 86vw" />
            <div class="meta">
              <div>
                <h3>
                  <a href={`/realizacje/${r.id}`}>{r.data.title}</a>
                </h3>
                <p class="muted">
                  {cityName(r.data.city)}, {r.data.district} · {r.data.area} m² · {r.data.standard}
                </p>
              </div>
              <a href={`/realizacje/${r.id}`} class="more" aria-label={`Zobacz realizację: ${r.data.title}`}>
                Zobacz →
              </a>
            </div>
          </article>
        ))
      }
      <article class="card end">
        <p class="end-t">Twoje mieszkanie może być następne.</p>
        <a href="#kontakt" class="btn">Umów konsultację</a>
      </article>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const section = document.getElementById('realizacje')!;
  const track = section.querySelector<HTMLElement>('.track')!;
  gsap.matchMedia().add('(min-width: 900px) and (prefers-reduced-motion: no-preference)', () => {
    const dist = () => track.scrollWidth - window.innerWidth;
    gsap.to(track, {
      x: () => -dist(),
      ease: 'none',
      scrollTrigger: {
        trigger: section.querySelector('.pin'),
        start: 'top top',
        end: () => '+=' + dist(),
        pin: true,
        scrub: 0.8,
        invalidateOnRefresh: true,
      },
    });
  });
</script>

<style>
  .realizacje {
    background: var(--stone);
  }
  .pin {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(28px, 4vh, 48px);
    padding-block: 100px 32px;
    overflow: hidden;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 40px;
    flex-wrap: wrap;
  }
  .head h2 {
    margin-top: 14px;
    font-size: clamp(2.2rem, 4.2vw, 3.6rem);
  }
  .head p {
    max-width: 420px;
  }
  .track {
    display: flex;
    gap: clamp(20px, 3vw, 48px);
    padding-inline: var(--gutter);
    width: max-content;
  }
  .card {
    width: min(56vw, calc((100vh - 380px) * 1.5));
    flex: none;
  }
  .meta {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
    padding-top: 18px;
  }
  .meta h3 a {
    text-decoration: none;
  }
  .meta p {
    font-size: 0.9rem;
    margin-top: 6px;
  }
  .more {
    white-space: nowrap;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--brass);
  }
  .end {
    width: min(30vw, 420px);
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 24px;
    padding: 40px;
    background: var(--ink);
    color: var(--stone);
    aspect-ratio: auto;
  }
  .end-t {
    font: 380 2.2rem/1.1 var(--serif);
  }

  @media (max-width: 899px), (prefers-reduced-motion: reduce) {
    .track {
      width: auto;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      padding-bottom: 12px;
      scrollbar-width: thin;
    }
    .card {
      width: min(86vw, 640px);
      scroll-snap-align: start;
    }
    .end {
      width: min(70vw, 360px);
    }
  }
</style>
