---
import MockImg from '../MockImg.astro';
import salon from '../../assets/img/salon.jpg';
import dom from '../../assets/img/dom.jpg';
import lazienka from '../../assets/img/lazienka.jpg';
import kuchnia from '../../assets/img/kuchnia.jpg';

const services = [
  {
    img: salon,
    title: 'Mieszkania pod klucz',
    text: 'Zajmujemy się mieszkaniami od stanu deweloperskiego aż po oddanie kluczy. Wszystkie prace prowadzimy w jednym harmonogramie.',
    focus: 'Ściany w tolerancji 2 mm na 2 m',
    points: ['Tynki, gładzie, zabudowy GK', 'Podłogi i drzwi', 'Elektryka i hydraulika'],
  },
  {
    img: dom,
    title: 'Domy jednorodzinne',
    text: 'Wykańczamy domy jednorodzinne: od tynków i gładzi po malowanie i biały montaż.',
    focus: 'Codzienne sprzątanie i wywóz odpadów',
    points: ['Tynki, gładzie, malowanie', 'Podłogi i płytki', 'Biały montaż i drzwi'],
  },
  {
    img: lazienka,
    title: 'Łazienki',
    text: 'Robimy łazienki od surowych ścian: hydroizolacja, płytki, odpływy liniowe, stelaże podtynkowe i biały montaż.',
    focus: 'Płytki od osi, fugi w linii',
    points: ['Hydroizolacja', 'Płytki wielkoformatowe', 'Biały montaż'],
  },
  {
    img: kuchnia,
    title: 'Kuchnie',
    text: 'Przygotowujemy kuchnię pod zabudowę: instalacje, ściany, podłogi i płytki nad blatem.',
    focus: 'Cięcie płytek z odciągiem pyłu',
    points: ['Instalacje pod zabudowę', 'Płytki i spieki nad blatem', 'Podłogi i oświetlenie'],
  },
];
---

<section id="uslugi" class="section g2" style="--h: 2">
  <div class="wrap">
    {
      [services.slice(0, 2), services.slice(2)].map((row, i) => (
        <div class="group">
          {i === 0 && (
            <div class="section-head">
              <h2>
                Zakres <em>usług</em>
              </h2>
            </div>
          )}
          <div class="grid">
            {row.map((s) => (
              <article class="svc">
                <MockImg src={s.img} alt={s.title} sizes="(min-width: 640px) 46vw, 92vw" />
                <div class="body">
                  <h3>{s.title}</h3>
                  <p class="muted">{s.text}</p>
                  <ul>
                    <li class="focus">{s.focus}</li>
                    {s.points.map((p) => (
                      <li>{p}</li>
                    ))}
                  </ul>
                </div>
              </article>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }
  .svc :global(.mock) {
    aspect-ratio: 16 / 9;
  }
  .svc :global(img) {
    transition: transform 1.2s var(--ease);
  }
  .svc:hover :global(img) {
    transform: scale(1.03);
  }
  .body {
    display: grid;
    gap: 10px;
    padding-top: 22px;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 8px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  li {
    font-size: 0.82rem;
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
  }
  /* wyróżniony chip: dokładność / czystość */
  li.focus {
    border-color: var(--brass);
    background: rgba(176, 141, 87, 0.12);
    font-weight: 600;
  }
  @media (max-width: 639px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
