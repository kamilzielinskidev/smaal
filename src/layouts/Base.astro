---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, businessJsonLd } from '../data/site';
import ogDefault from '../assets/img/salon-3.jpg';

interface Props {
  title: string;
  description?: string;
  image?: ImageMetadata;
  jsonLd?: object[];
  breadcrumbs?: { name: string; path: string }[];
}

const { title, description = site.description, image = ogDefault, jsonLd = [], breadcrumbs } = Astro.props;
// build.format 'file' daje w pathname końcówkę .html — canonical ma wskazywać czysty URL
const canonical = new URL(Astro.url.pathname.replace(/(\/index)?\.html$/, '') || '/', Astro.site).href;
const og = await getImage({ src: image, width: 1200, height: 630, format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site).href;

const schemas: object[] = [businessJsonLd(new URL('/', Astro.site).href), ...jsonLd];
if (breadcrumbs) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [{ name: 'Strona główna', path: '/' }, ...breadcrumbs].map((b, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: b.name,
      item: new URL(b.path, Astro.site).href,
    })),
  });
}
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#161513" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js', 'loading');
        var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) d.classList.add('reduce');
        var gl = false;
        try {
          var c = document.createElement('canvas');
          gl = !!(c.getContext('webgl2') || c.getContext('webgl'));
        } catch (e) {}
        if (reduce || !gl || (navigator.deviceMemory || 8) < 4) d.classList.add('no-3d');

        // Loader: czekamy na load, czcionki i pierwszą klatkę sceny 3D (jeśli jest) — najwyżej 6 s.
        var hero = new Promise(function (r) {
          addEventListener('smaal:hero-ready', r);
        });
        var ready = new Promise(function (r) {
          addEventListener('load', r);
        }).then(function () {
          return Promise.all([document.fonts && document.fonts.ready, !d.classList.contains('no-3d') && document.getElementById('hero') && hero]);
        });
        Promise.race([ready, new Promise(function (r) { setTimeout(r, 6000); })]).then(function () {
          d.classList.remove('loading');
          dispatchEvent(new Event('smaal:ready'));
        });
      })();
    </script>
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <div class="loader" aria-hidden="true">
      <svg viewBox="0 0 100 84"><path pathLength="1" d="M10 10H90V74H10Z M42 10V33 M10 42H42 M34 42V65" /></svg>
    </div>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      import Lenis from 'lenis';
      import { goTo } from '../lib/scroll';

      if (!document.documentElement.classList.contains('reduce')) {
        const lenis = new Lenis({ lerp: 0.09, autoRaf: true });
        (window as any).lenis = lenis;
        if (document.documentElement.classList.contains('loading')) lenis.stop();
        window.addEventListener('smaal:ready', () => lenis.start());
      }

      // Kotwice na tej samej stronie — płynnie przez Lenis, z fokusem na celu.
      document.addEventListener('click', (e) => {
        const a = (e.target as Element).closest('a[href*="#"]') as HTMLAnchorElement | null;
        if (!a || a.pathname !== location.pathname) return;
        const target = document.querySelector<HTMLElement>(a.hash);
        if (!target) return;
        e.preventDefault();
        goTo(target);
        history.replaceState(null, '', a.hash);
      });
    </script>

    <style>
      :global(html.loading) {
        overflow: hidden;
      }
      .loader {
        position: fixed;
        inset: 0;
        z-index: 100;
        display: grid;
        place-items: center;
        background: var(--ink);
        opacity: 0;
        visibility: hidden;
        transition:
          opacity 0.7s var(--ease),
          visibility 0.7s;
      }
      :global(html.loading) .loader {
        opacity: 1;
        visibility: visible;
      }
      .loader svg {
        width: 76px;
        fill: none;
        stroke: var(--brass);
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
      }
      .loader path {
        stroke-dasharray: 1;
        stroke-dashoffset: 1;
        animation: draw 2.2s var(--ease) infinite;
      }
      :global(.reduce) .loader path {
        animation: none;
        stroke-dasharray: none;
      }
      @keyframes draw {
        60% {
          stroke-dashoffset: 0;
        }
        100% {
          stroke-dashoffset: -1;
        }
      }
    </style>
  </body>
</html>
